# Copy this file to .env and fill in your token to activate the CrewAI
# Chief Strategist's LLM synthesis step. Without it, the app still runs
# fine -- strategist_note just falls back to the deterministic rule-engine
# text (see app/agents/crew.py) and agent_synthesis_used comes back false.

# huggingface.co -> Settings -> Access Tokens -> create a "read" token
# (must have "Make calls to Inference Providers" permission enabled)
HF_TOKEN=

# Optional: override the default model (must be an ungated model your
# token can access via HF Inference Providers)
# HF_LLM_MODEL=huggingface/Qwen/Qwen2.5-7B-Instruct
